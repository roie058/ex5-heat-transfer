/* Modern Light Slate Stylesheet — unified with AboutWindow */

QWidget#HeatTransferWindow,
QWidget#GraphWindow {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QFrame#stage_card,
QFrame#controls_card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
}

QLabel {
    color: #475569;
    background: transparent;
}

QLabel#app_title {
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
}

QLabel#section_title {
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
}

QLabel#conductivity_title {
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
}

QLabel#clock_label {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-family: "Consolas", monospace;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
}

QLabel#status_pill_idle {
    background-color: #f1f5f9;
    color: #64748b;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
}

QLabel#status_pill_running {
    background-color: #ecfdf5;
    color: #059669;
    border: 1px solid #a7f3d0;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
}

QLabel#status_pill_equilibrium {
    background-color: #eff6ff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
}

QLabel#flux_label {
    background-color: #fff7ed;
    color: #c2410c;
    border: 1px solid #fed7aa;
    border-radius: 8px;
    font-family: "Consolas", monospace;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
}

QDoubleSpinBox {
    background-color: #f8fafc;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 5px 8px;
    font-family: "Consolas", monospace;
    font-size: 13px;
    font-weight: 600;
}

QDoubleSpinBox:focus {
    border: 1px solid #0284c7;
    background-color: #ffffff;
}

QDoubleSpinBox[readOnly="true"] {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #e2e8f0;
}

QDoubleSpinBox[readOnly="true"]::up-button,
QDoubleSpinBox[readOnly="true"]::down-button {
    width: 0px;
    border: none;
}

QPushButton {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f1f5f9;
    color: #0f172a;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton#start_stop_button {
    background-color: #16a34a;
    color: #ffffff;
    border: 1px solid #15803d;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#start_stop_button:hover {
    background-color: #15803d;
}

QPushButton#start_stop_button:checked {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #b91c1c;
}

QPushButton#start_stop_button:checked:hover {
    background-color: #b91c1c;
}

QPushButton#graphs_button {
    background-color: #f0f9ff;
    color: #0284c7;
    border: 1px solid #bae6fd;
}

QPushButton#graphs_button:hover {
    background-color: #e0f2fe;
    border-color: #0284c7;
}

QSlider::groove:vertical {
    background: #e2e8f0;
    width: 6px;
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0, stop:0 #fca5a5, stop:1 #dc2626);
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #ffffff;
    border: 2px solid #dc2626;
    height: 16px;
    width: 16px;
    margin: 0 -6px;
    border-radius: 9px;
}

QSlider::handle:vertical:hover {
    background: #fef2f2;
    border-color: #b91c1c;
}

QComboBox {
    combobox-popup: 0;
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 600;
}

QComboBox:hover {
    border-color: #0284c7;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #e0f2fe;
    selection-color: #0369a1;
    outline: none;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding-left: 6px;
}
