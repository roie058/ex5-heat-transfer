/* Shared stylesheet for Heat Transfer Simulation (PySide6 QSS) */

QWidget#HeatTransferWindow,
QWidget#GraphWindow {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QFrame#stage_card,
QFrame#controls_card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
}

QLabel {
    color: #334155;
    background: transparent;
}

QLabel#section_title {
    color: #0f172a;
    font-size: 14px;
    font-weight: 700;
}

QLabel#conductivity_title {
    color: #475569;
    font-size: 12px;
    font-weight: 600;
}

QLabel#thermal_bridge {
    background-color: #cbd5e1;
    border-top: 1px solid #94a3b8;
    border-bottom: 1px solid #94a3b8;
}

QDoubleSpinBox {
    background-color: #f8fafc;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 13px;
    font-weight: 600;
}

QDoubleSpinBox:focus {
    border: 1px solid #0284c7;
    background-color: #ffffff;
}

QDoubleSpinBox[readOnly="true"] {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #e2e8f0;
}

QPushButton {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
}

QPushButton:pressed {
    background-color: #e2e8f0;
}

QPushButton#start_stop_button {
    background-color: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#start_stop_button:hover {
    background-color: #bbf7d0;
    border-color: #4ade80;
}

QPushButton#start_stop_button:checked {
    background-color: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
}

QPushButton#start_stop_button:checked:hover {
    background-color: #fecaca;
    border-color: #f87171;
}

QPushButton#graphs_button {
    background-color: #f0f9ff;
    color: #0369a1;
    border: 1px solid #bae6fd;
}

QPushButton#graphs_button:hover {
    background-color: #e0f2fe;
    border-color: #38bdf8;
}

QSlider::groove:vertical {
    background: #e2e8f0;
    width: 6px;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #0284c7;
    border: 2px solid #ffffff;
    height: 16px;
    width: 16px;
    margin: 0 -6px;
    border-radius: 9px;
}

QSlider::handle:vertical:hover {
    background: #0369a1;
}

QComboBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 600;
}

QComboBox:hover {
    border-color: #94a3b8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #e0f2fe;
    selection-color: #0369a1;
    outline: none;
}
